{
  "servers": {
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time"],
      "env": {},
      "description": "Time and date utilities"
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server", "--transport", "stdio"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Web search via Brave Search API"
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": {},
      "description": "HTTP fetch capabilities"
    },
    "git": {
      "command": "uvx", 
      "args": ["mcp-server-git"],
      "env": {},
      "description": "Git repository operations"
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "memory.json"
      },
      "description": "Persistent conversation memory"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {},
      "description": "Step-by-step reasoning capabilities"
    },
    "youtube-transcript": {
      "command": "npx", 
      "args": ["-y", "@kimtaeyoon83/mcp-server-youtube-transcript"],
      "env": {},
      "description": "YouTube video transcript extraction"
    },
    "wikipedia": {
      "command": "wikipedia-mcp",
      "args": [],
      "env": {},
      "description": "Wikipedia encyclopedia lookup"
    },
    "mcp-proxy-multi": {
        "command": "mcp-proxy",
        "args": ["--port=8080", "--named-server-config", "./mcp_proxy_servers.json"],
        "env": {},
        "description": "Multi-server HTTP/SSE to stdio proxy for Home Assistant, Hugging Face, and Context7"
    }
  },
  "discovery": {
    "auto_detect_tools": true,
    "tool_refresh_interval": 300,
    "enable_hot_reload": false
  },
  "transport": {
    "default": "stdio",
    "timeout": 30,
    "retry_attempts": 3
  }
}